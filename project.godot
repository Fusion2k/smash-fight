; THROWAWAY #11 experiment. Not the first-playable game.
config_version=5

[application]

config/name="Smash Fight - Combat Timing Lab"
run/main_scene="res://prototype/timing_lab.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1180
window/size/viewport_height=780
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60
2d/physics_engine="GodotPhysics2D"

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.09, 1)
